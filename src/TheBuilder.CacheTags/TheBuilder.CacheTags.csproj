<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageId>TheBuilder.CacheTags</PackageId>
    <Product>Cache Tags for Umbraco</Product>
    <Title>Cache keys and exact purges for the Umbraco Delivery API</Title>
    <!-- The local fallback. A release sets the version from its tag. -->
    <Version>0.1.0</Version>
    <Authors>Daniel Schmidt</Authors>
    <Description>Tag Umbraco Delivery API responses with cache keys, and purge exactly the right ones at the frontend once every delivery server has applied a change.</Description>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-cms;delivery-api;headless;cache;cache-tags;next.js;cdn</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/thebuilder/umbraco-cache-tags</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thebuilder/umbraco-cache-tags.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/thebuilder/umbraco-cache-tags/releases for release notes.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <BackofficeClientDirectory>$(MSBuildProjectDirectory)/Client</BackofficeClientDirectory>
    <BackofficeAssetsPattern>wwwroot/App_Plugins/TheBuilder.CacheTags/**/*</BackofficeAssetsPattern>
    <BackofficeAssetsDirectory>$(MSBuildProjectDirectory)/wwwroot/App_Plugins/TheBuilder.CacheTags</BackofficeAssetsDirectory>
    <BackofficeManifest>$(BackofficeAssetsDirectory)/umbraco-package.json</BackofficeManifest>
    <BackofficeEntryPoint>$(BackofficeAssetsDirectory)/cache-tags.js</BackofficeEntryPoint>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <!-- Security floors for dependencies inherited from the supported Umbraco range. -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Client\**" />
    <Content Remove="wwwroot/App_Plugins/TheBuilder.CacheTags/**/*" />
    <None Include="Client\umbraco-package.json" Pack="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot/App_Plugins/TheBuilder.CacheTags/" />
    <InternalsVisibleTo Include="TheBuilder.CacheTags.Tests" />
  </ItemGroup>
  <!-- The backoffice dashboard (Client/) is built while packing, with the package's version in the
       manifest Umbraco reads, and its output packed as static web assets under App_Plugins. -->
  <Target Name="BuildBackofficeAssetsForPack" Condition="'$(_IsPacking)' == 'true' and '$(NoBuild)' != 'true'">
    <Exec Command="corepack pnpm build" WorkingDirectory="$(BackofficeClientDirectory)" EnvironmentVariables="PACKAGE_VERSION=$(Version)" />
  </Target>
  <Target Name="RefreshBackofficeStaticWebAssets" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="BuildBackofficeAssetsForPack">
    <ItemGroup><Content Include="$(BackofficeAssetsPattern)" /></ItemGroup>
  </Target>
  <Target Name="ValidateBackofficeAssetsForPack" BeforeTargets="IncludeStaticWebAssetsPackItems" Condition="'$(_IsPacking)' == 'true'">
    <Error Condition="!Exists('$(BackofficeManifest)')" Text="Cannot pack TheBuilder.CacheTags because the backoffice manifest is missing." />
    <Error Condition="!Exists('$(BackofficeEntryPoint)')" Text="Cannot pack TheBuilder.CacheTags because the backoffice entry point is missing." />
  </Target>
</Project>
