<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The site TheBuilder.CacheTags is verified against end to end, with ../nextjs as its frontend.
       See ../README.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>TheBuilder.CacheTags.Example</UserSecretsId>
    <IsPackable>false</IsPackable>
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <!-- Lift Umbraco's vulnerable transitive versions; see Directory.Packages.props. -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <!-- The package, installed through its composer. By default the project; to test the packed
       .nupkg instead, the artifact that gets published, pass its version (see ../README.md). It is
       restored from ../../artifacts, or from CacheTagsPackageSource. -->
  <ItemGroup Condition="'$(CacheTagsPackageVersion)' == ''">
    <ProjectReference Include="../../src/TheBuilder.CacheTags/TheBuilder.CacheTags.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(CacheTagsPackageVersion)' != ''">
    <CacheTagsPackageSource Condition="'$(CacheTagsPackageSource)' == ''">$(MSBuildThisFileDirectory)../../artifacts</CacheTagsPackageSource>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(CacheTagsPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(CacheTagsPackageVersion)' != ''">
    <PackageReference Include="TheBuilder.CacheTags" VersionOverride="$(CacheTagsPackageVersion)" />
  </ItemGroup>
</Project>
