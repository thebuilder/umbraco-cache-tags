<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The site TheBuilder.CacheTags is verified against end to end, with ../nextjs as its frontend.
       See ../README.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Umbraco 19 runs on .NET 11 only: -p:SampleUmbracoVersion=19.0.0-rc2 runs the sample on it. -->
    <TargetFramework Condition="$(SampleUmbracoVersion.StartsWith('19'))">net11.0</TargetFramework>
    <!-- The .NET 11 SDK's static asset compression fails on Umbraco 19's backoffice assets
         ("Endpoints not found for related asset"), and a local sample has no need for it. -->
    <CompressionEnabled Condition="'$(TargetFramework)' == 'net11.0'">false</CompressionEnabled>
    <UserSecretsId>TheBuilder.CacheTags.Example</UserSecretsId>
    <IsPackable>false</IsPackable>
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>
  <!-- Lift Umbraco 17's vulnerable transitive versions; see Directory.Packages.props. Umbraco 19 brings newer ones. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="MessagePack" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <!-- The package, installed through its composer. By default the project; to test the packed
       .nupkg instead, the artifact that gets published, pass its version (see ../README.md). It is
       restored from ../../artifacts, or from CacheTagsPackageSource. -->
  <ItemGroup Condition="'$(CacheTagsPackageVersion)' == ''">
    <ProjectReference Include="../../src/TheBuilder.CacheTags/TheBuilder.CacheTags.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(CacheTagsPackageVersion)' != ''">
    <CacheTagsPackageSource Condition="'$(CacheTagsPackageSource)' == ''">$(MSBuildThisFileDirectory)../../artifacts</CacheTagsPackageSource>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(CacheTagsPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(CacheTagsPackageVersion)' != ''">
    <PackageReference Include="TheBuilder.CacheTags" VersionOverride="$(CacheTagsPackageVersion)" />
  </ItemGroup>
</Project>
