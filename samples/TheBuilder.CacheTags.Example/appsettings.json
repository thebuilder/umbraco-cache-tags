{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "d4d8c311-590d-4286-8797-e0f515607d3e",
        "SanitizeTinyMce": true
      },
      "Hosting": {
        "Debug": false
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Runtime": {
        "Mode": "Development"
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "local@example.invalid",
        "UnattendedUserPassword": "LocalOnly!42"
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "ApiKey": "example-local-preview-key",
        "RichTextOutputAsJson": false,
        "OutputCache": {
          "Enabled": false,
          "ContentDuration": "00:05:00",
          "MediaDuration": "00:05:00"
        },
        "Media": {
          "Enabled": true,
          "PublicAccess": true
        }
      },
      "Imaging": {
        "HMACSecretKey": "ZXhhbXBsZS1sb2NhbC1vbmx5LWhtYWMtc2VjcmV0LWtleS1ub3QtZm9yLXByb2R1Y3Rpb24tdXNlLTAxMjM0NTY3ODk="
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
