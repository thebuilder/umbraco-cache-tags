# Local development values only. Put overrides in .env.local, which git ignores.

# The Umbraco sample site (../TheBuilder.CacheTags.Example).
UMBRACO_URL=http://localhost:5320

# The secret purge webhooks are signed with, and the one before it while a rotation is under way.
# The Umbraco site must sign with one of them.
CACHE_TAGS_WEBHOOK_SECRET=example-local-webhook-secret
CACHE_TAGS_WEBHOOK_SECRET_PREVIOUS=

# Where scripts/purge.mjs sends its webhook.
FRONTEND_URL=http://localhost:3000
