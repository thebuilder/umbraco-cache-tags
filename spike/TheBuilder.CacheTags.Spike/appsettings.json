{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "3c0f8a52-6f1e-4b3e-9d43-2b7f0d1c9a11",
        "SanitizeTinyMce": true
      },
      "Hosting": {
        "Debug": true
      },
      "ModelsBuilder": {
        "ModelsMode": "Nothing"
      },
      "Runtime": {
        "Mode": "Development"
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "http://localhost:5317"
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "local@example.invalid",
        "UnattendedUserPassword": "LocalOnly!42"
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "ApiKey": "spike-local-preview-key",
        "RichTextOutputAsJson": false,
        "OutputCache": {
          "Enabled": false,
          "ContentDuration": "00:05:00",
          "MediaDuration": "00:05:00"
        },
        "Media": {
          "Enabled": true,
          "PublicAccess": true
        }
      },
      "Imaging": {
        "HMACSecretKey": "c3Bpa2UtbG9jYWwtb25seS1obWFjLXNlY3JldC1rZXktbm90LWZvci1wcm9kdWN0aW9uLXVzZS0wMTIzNDU2Nzg5"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  }
}