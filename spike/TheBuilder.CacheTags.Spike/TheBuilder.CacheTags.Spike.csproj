<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Milestone 1 spike: a throwaway Umbraco site that probes the Delivery API. See ../FINDINGS.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <BuildInParallel>false</BuildInParallel>
    <!-- Throwaway probe code that calls obsolete Umbraco APIs on purpose to seed fixtures quickly. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>
</Project>
